# Everything is optional for a local run. With nothing set the prototype runs a
# demo portfolio at real last-close prices (Upstox's public candles) with
# practice fills, and the agents run scripted examples, so anyone can open it.
# Hosting it for colleagues on Vercel: see DEPLOY.md.

# ─── Claude ───────────────────────────────────────────────────────────────────
# The chat assistant, agents that reason, the written brief. Make the key inside a
# workspace in the Claude Console; for a key that isn't, set ANTHROPIC_WORKSPACE_ID too.
ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
# Default model; each person can switch in Settings (claude-sonnet-5-5 or claude-opus-5-5).
CLAUDE_MODEL=claude-sonnet-5-5

# ─── Upstox (local runs only) ─────────────────────────────────────────────────
# Anyone can also connect Upstox in the app (Settings → Upstox). For a local
# run without sign-in, these fill whatever isn't connected there. Hosted, they
# are ignored: each person's tokens are their own.

# Live prices, news, fundamentals: the 1-year read-only Analytics Token (My Apps → Analytics).
UPSTOX_ANALYTICS_TOKEN=
# Your account (holdings, funds, real charges and margin): the daily access token, expires 03:30 IST.
UPSTOX_ACCESS_TOKEN=
# Upstox sandbox for orders (My Apps → Sandbox → Generate; valid 30 days).
UPSTOX_SANDBOX_TOKEN=

# The prototype never places live orders. There is deliberately no switch for it.

PORT=8787

# ─── Hosting (Vercel sets VERCEL=1; AGENTS_HOSTED=1 tries it locally) ─────────
# APP_ACCESS_CODE=          the code people type to sign in (turns sign-in on)
# SESSION_SECRET=           32+ random characters
# SECRETS_KEY=              32+ random characters; encrypts each person's Upstox tokens
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# AGENTS_DB_KEY=            Vault secret agents_server_key (supabase/agents.sql)
# ALLOWED_EMAIL_DOMAIN=upstox.com
# CHAT_DAILY_LIMIT=40  AGENT_DAILY_LIMIT=30  BRIEF_DAILY_LIMIT=12  CLAUDE_DAILY_LIMIT_ALL=1500

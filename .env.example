# Everything is optional. With nothing set the prototype runs a demo portfolio
# at real last-close prices (Upstox's public candles) with practice fills, and
# the agents run scripted examples, so anyone can open it.

# Claude: the chat assistant, agents that reason, the written brief.
# Model: claude-opus-5-5. Without a key, agents run scripted examples.
ANTHROPIC_API_KEY=

# Market data (live prices). The 1-year read-only Analytics Token from
# Upstox → My Apps → Analytics. Needs no static IP for market data.
UPSTOX_ANALYTICS_TOKEN=

# Your account (holdings, funds, real charges and margin). The daily access
# token from your Upstox API app; it expires at 03:30 IST every night.
UPSTOX_ACCESS_TOKEN=

# Upstox sandbox for orders (My Apps → Sandbox → Generate; valid 30 days).
# When set, the "Sandbox" mode sends approved orders to Upstox's sandbox.
UPSTOX_SANDBOX_TOKEN=

# The prototype never places live orders. There is deliberately no switch for it.

PORT=8787
